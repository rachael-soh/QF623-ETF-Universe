# ── Data files ────────────────────────────────────────────────────────────────
# Raw and processed data are large binary files pulled from WRDS/CRSP.
# They must NOT be committed — regenerate using the notebooks (see data/README.md).
*.parquet
*.feather
*.h5
*.hdf5

# Proprietary ETF universe files from ETFG — not licensed for redistribution
clean_etf_master_universe.csv
etf_long_short_project/data/external/etf_universe.csv
etf_long_short_project/data/external/etf_universe.txt
output.parquet

# Any CSV that looks like a data dump (allow small config/lookup CSVs explicitly if needed)
*_data.csv
*_returns.csv
*_positions.csv
momentum_positions_by_rebalance.csv
momentum_monthly_returns.csv

# ── Jupyter Notebooks ─────────────────────────────────────────────────────────
# Checkpoint folders created automatically by Jupyter — not source code
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Strip notebook output before committing (keeps diffs clean)
# Uncomment the next two lines if using nbstripout:
# *.ipynb filter=nbstripout
# *.ipynb diff=ipynb

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
.env
ENV/

# ── IDE and editor files ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store           # macOS metadata
Thumbs.db           # Windows thumbnail cache

# ── WRDS credentials ──────────────────────────────────────────────────────────
# NEVER commit database credentials
.pgpass
wrds_credentials*
*.key
*.pem

# ── Logs and temp files ───────────────────────────────────────────────────────
*.log
*.tmp
*.bak
